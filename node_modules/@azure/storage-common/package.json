{
  "name": "@azure/storage-common",
  "sdk-type": "client",
  "sideEffects": false,
  "author": "Microsoft Corporation",
  "version": "12.5.0",
  "description": "Azure Storage Common Client Library for JavaScript",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azure/azure-sdk-for-js",
    "directory": "sdk/storage/storage-common"
  },
  "homepage": "https://github.com/Azure/azure-sdk-for-js/tree/main/sdk/storage/storage-common/README.md",
  "bugs": {
    "url": "https://github.com/Azure/azure-sdk-for-js/issues"
  },
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "keywords": [
    "azure",
    "cloud"
  ],
  "browser": "./dist/browser/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#platform/*": {
      "browser": "./src/*-browser.mts",
      "react-native": "./src/*-react-native.mts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@azure/abort-controller": "^2.1.2",
    "@azure/core-auth": "^1.9.0",
    "@azure/core-http-compat": "^2.4.0",
    "@azure/core-rest-pipeline": "^1.24.0",
    "@azure/core-tracing": "^1.2.0",
    "@azure/core-util": "^1.11.0",
    "@azure/logger": "^1.1.4",
    "events": "^3.3.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@azure/logger": "^1.1.4",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-istanbul": "^4.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "playwright": "^1.60.0",
    "prettier": "^3.9.1",
    "react-native": "^0.84.1",
    "rimraf": "^6.1.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "@azure-tools/test-utils-vitest": "^2.0.1",
    "@azure/dev-tool": "^1.0.0",
    "@azure/eslint-plugin-azure-sdk": "^3.0.0"
  },
  "type": "module",
  "react-native": "./dist/react-native/index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "react-native": {
        "types": "./dist/react-native/index.d.ts",
        "default": "./dist/react-native/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "npm run clean && dev-tool run build-package && dev-tool run extract-api && npm run copyAssets",
    "build:samples": "echo Skipped.",
    "check-format": "prettier --list-different --config ../../../.prettierrc.json --ignore-path ../../../.prettierignore \"src/**/*.{ts,cts,mts}\" \"test/**/*.ts\" \"*.{js,json}\"",
    "clean": "rimraf --glob dist dist-* types temp statistics.html coverage coverage-browser .nyc_output *.tgz *.log test*.xml TEST*.xml",
    "docs": "echo Skipped.",
    "extract-api": "dev-tool run build-package && dev-tool run extract-api",
    "format": "prettier --write --config ../../../.prettierrc.json --ignore-path ../../../.prettierignore \"src/**/*.{ts,cts,mts}\" \"test/**/*.ts\" \"*.{js,json}\"",
    "lint": "eslint package.json src test",
    "lint:fix": "eslint package.json src test --fix",
    "pack": "pnpm pack 2>&1",
    "test": "tsc -b --noEmit && npm run test:node && npm run test:browser",
    "test:browser": "echo skipped",
    "test:node": "dev-tool run test:vitest",
    "update-snippets": "dev-tool run update-snippets",
    "copyAssets": "node copyJSFiles.cjs"
  }
}